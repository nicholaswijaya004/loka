{
  "uid": "loka-golden-signals",
  "title": "Loka: golden signals",
  "tags": ["loka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pull makes a dead process visible: Prometheus records up = 0 when a scrape fails.",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "up{job=~\"api|relay\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "API: traffic, errors",
      "id": 2,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by route",
      "description": "Traffic. Counted by otelhttp per route pattern; /metrics and /healthz are not wrapped, so scrapes are not traffic.",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses per second, by status code",
      "description": "4xx (400 bad input, 409 sold out) are the API working correctly; 5xx are ours.",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx share of responses, by route",
      "description": "Errors. With no 5xx at all the numerator has no series; `or ... * 0` turns that into 0 instead of No data.",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "(sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"api\", http_response_status_code=~\"5..\"}[$__rate_interval])) or sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"api\"}[$__rate_interval])) * 0) / sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request duration: p99 by route",
      "description": "Estimated from histogram buckets (edges 5, 10, 25, 50, 75, 100, 250, 500, 750 ms, 1, 2.5, 5, 7.5, 10 s): the true p99 is somewhere in the bucket the estimate falls in.",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "API: latency, saturation",
      "id": 7,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "POST /bookings: p50, p95, p99",
      "description": "Buckets summed across instances first, then the quantile: never average per-instance percentiles.",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\", http_request_method=\"POST\", http_route=\"/bookings\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\", http_request_method=\"POST\", http_route=\"/bookings\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\", http_request_method=\"POST\", http_route=\"/bookings\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool: connections in use, share of max",
      "description": "Saturation. At 1.0 every connection is busy and the next request waits.",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "pgxpool_acquired_connections{job=\"api\"} / pgxpool_max_connections{job=\"api\"}",
          "legendFormat": "{{db_client_connection_pool_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool: requests waiting for a connection (average)",
      "description": "Seconds spent waiting per second = how many requests wait at once, on average (Little's law). Above 0 means the pool is the queue.",
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "rate(pgxpool_empty_acquire_wait_time_nanoseconds_total{job=\"api\"}[$__rate_interval]) / 1e9",
          "legendFormat": "{{db_client_connection_pool_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU used (cores) and goroutines",
      "description": "CPU per process; goroutines on the right axis.",
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "goroutines.*" },
            "properties": [{ "id": "custom.axisPlacement", "value": "right" }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"api|relay\"}[$__rate_interval])",
          "legendFormat": "cpu {{job}}",
          "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "B",
          "expr": "go_goroutines{job=~\"api|relay\"}",
          "legendFormat": "goroutines {{job}}",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Pipeline: outbox → relay → Kafka",
      "id": 12,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Relay: events per second",
      "description": "Traffic (published, counted once a batch commits) and errors (failed: Kafka did not acknowledge; retried next poll). A counter never incremented has no series, hence `or vector(0)`.",
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "sum(rate(loka_relay_events_published_total{job=\"relay\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "published",
          "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "B",
          "expr": "sum(rate(loka_relay_events_failed_total{job=\"relay\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "failed",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Relay: batch duration, p50 and p99",
      "description": "Fetch, publish and mark one non-empty batch, commit included. Empty polls are not recorded.",
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loka_relay_batch_duration_seconds_bucket{job=\"relay\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loka_relay_batch_duration_seconds_bucket{job=\"relay\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox: unpublished events",
      "description": "Saturation. Steady and small: the relay keeps up. Growing: it does not. max, not sum: every relay replica reads the same table.",
      "id": 15,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "max(loka_outbox_unpublished{job=\"relay\"})",
          "legendFormat": "unpublished",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox: age of the oldest unpublished event",
      "description": "How late the oldest event is. A sawtooth up to about the poll interval is normal; a line that keeps rising is a stuck (poison) event or a stopped relay.",
      "id": 16,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "max(loka_outbox_oldest_unpublished_age_seconds{job=\"relay\"})",
          "legendFormat": "oldest",
          "range": true
        }
      ]
    }
  ]
}
